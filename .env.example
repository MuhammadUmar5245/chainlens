# Copy this file to .env and fill in the values. .env is ignored by git - never commit real keys.

# --- external APIs (server only; the React app never sees these) ---
NOWNODES_API_KEY=
# header = key sent in the "api-key" header; url = key appended to the endpoint URL
NOWNODES_AUTH_MODE=header
# only needed for the planned "Ask" feature
ANTHROPIC_API_KEY=

# --- database passwords (used by docker-compose for the containers) ---
POSTGRES_PASSWORD=chainlens
CLICKHOUSE_PASSWORD=chainlens

# --- data + limits ---
# API data older than this many days is deleted automatically
HISTORY_DAYS=30
MAX_UPLOAD_GB=5
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- analytics defaults ---
KMEANS_K=4
ANOMALY_Z=3.0
